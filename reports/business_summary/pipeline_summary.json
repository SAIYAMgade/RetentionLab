      "effect_size": 0.2742,
      "effect_size_type": "Rank-biserial correlation",
      "active_median": 27.0,
      "inactive_median": 53.0,
      "active_iqr": 52.0,
      "inactive_iqr": 97.0,
      "statistically_significant": true,
      "business_interpretation": "Inactive customers showed a median recency of 53 days vs 27 days for active customers. The strong effect size (0.27) confirms recency decay is the single strongest observational marker of impending inactivity."
    },
    {
      "test_name": "Welch's t-test: Log-Transformed Total Spend (Active vs Inactive)",
      "null_hypothesis": "Active and inactive customers have equal mean log-transformed lifetime spend.",
      "alt_hypothesis": "Active customers have significantly higher mean log-transformed lifetime spend.",
      "test_statistic": 4.8437,
      "p_value": 1.3264189381022369e-06,
      "effect_size": 0.1181,
      "effect_size_type": "Cohen's d (log scale)",
      "active_mean_spend": 882.9,
      "inactive_mean_spend": 688.06,
      "statistically_significant": true,
      "business_interpretation": "Active customers averaged $882.90 lifetime spend compared to $688.06 for inactive customers. Active customers generate substantially greater cumulative value (Cohen's d = 0.12), making retention of active tiers financially vital."
    },
    {
      "test_name": "Mann-Whitney U: Total Purchase Frequency (Active vs Inactive)",
      "null_hypothesis": "Active and inactive customers make identical numbers of historical purchases.",
      "alt_hypothesis": "Active customers make significantly more lifetime purchases than inactive customers.",
      "test_statistic": 6812014.5,
      "p_value": 5.195681822554799e-15,
      "effect_size": 0.1176,
      "effect_size_type": "Rank-biserial correlation",
      "active_median": 9.0,
      "inactive_median": 8.0,
      "statistically_significant": true,
      "business_interpretation": "Retained customers had a median of 9 historical orders vs 8 for churning customers, demonstrating that repurchase depth correlates with long-term retention."
    },
    {
      "test_name": "Mann-Whitney U: Refund Rate (Inactive vs Active)",
      "null_hypothesis": "There is no difference in historical refund rates between active and inactive customers.",
      "alt_hypothesis": "Historical refund rates differ significantly between active and inactive cohorts.",
      "test_statistic": 5904404.0,
      "p_value": 0.00502375076174582,
      "effect_size": 0.0313,
      "effect_size_type": "Rank-biserial correlation",
      "active_mean": 0.0236,
      "inactive_mean": 0.0242,
      "statistically_significant": true,
      "business_interpretation": "Inactive customers exhibited a mean refund rate of 2.42% vs 2.36% for active customers (p=0.0050). High post-purchase friction elevates inactivity risk."
    }
