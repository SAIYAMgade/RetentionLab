# SignalForge Environment Configuration

# Application
APP_ENV=development
APP_NAME=SignalForge
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL for Docker/Production, SQLite supported for local testing)
DATABASE_URL=postgresql://signalforge:signalforge_password@localhost:5432/signalforge_db
TEST_DATABASE_URL=sqlite:///./test_signalforge.db

# Storage Directories
DATA_DIR=./data
REPORTS_DIR=./reports

# Observability
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Airflow
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_API_URL=http://localhost:8080/api/v1
