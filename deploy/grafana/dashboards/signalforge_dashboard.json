      "id": 1,
      "title": "Pipeline Runs by Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (signalforge_pipeline_runs_total)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Records Ingested vs Rejected",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (stage) (signalforge_records_processed_total{stage='LOAD'})",
          "legendFormat": "Loaded Records",
          "refId": "A"
        },
        {
          "expr": "sum(signalforge_records_rejected_total)",
          "legendFormat": "Rejected Records",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Data Freshness SLA (Age in Seconds)",
      "type": "gauge",
      "targets": [
        {
          "expr": "signalforge_data_freshness_seconds",
          "legendFormat": "{{dataset}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "title": "Execution Latency (p90 Duration)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.90, sum by (le, pipeline) (rate(signalforge_pipeline_duration_seconds_bucket[5m])))",
          "legendFormat": "{{pipeline}} p90 (sec)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "title": "Data Quality Violations by Rule",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (rule) (signalforge_validation_failures_total)",
          "legendFormat": "{{rule}}",
          "refId": "A"
        }
      ]
    }
